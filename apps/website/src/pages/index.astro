---
import Base from '../layouts/Base.astro';

const TALLY_FORM_ID = 'aQX9NB';

const cta = {
  'data-tally-open': TALLY_FORM_ID,
  'data-tally-layout': 'modal',
  'data-tally-width': '480',
  'data-tally-emoji-text': '👋',
  'data-tally-emoji-animation': 'wave',
};
---

<Base title="Market Miam — l’adresse de votre stand">
  <header class="bar">
    <a class="wordmark" href="/">
      <img src="/logo.webp" alt="Market Miam" width="160" height="25" />
    </a>
    <button class="btn btn-ghost" {...cta}>Rejoindre le pilote</button>
  </header>

  <main>
    <section class="hero">
      <div>
        <p class="eyebrow">Pour les traiteurs de marché</p>
        <h1>Vos habitués savent quand vous venez, et ce que vous servez.</h1>
        <p class="lede">
          Market Miam vous donne une vitrine en ligne à votre nom, avec votre carte, vos jours
          de marché et le menu du jour. Vous donnez l’adresse une fois à vos clients, et ils
          peuvent la consulter quand ils veulent.
        </p>
        <p class="soon">
          <strong>Bientôt, la commande en ligne.</strong> Pendant le marché, vos clients
          pourront commander et payer sur votre vitrine, puis venir chercher leur commande au
          stand.
        </p>
        <div class="hero-actions">
          <button class="btn btn-solid" {...cta}>Rejoignez les premiers traiteurs</button>
        </div>
      </div>
      <figure class="shot">
        <img
          src="/storefront-demo.webp"
          alt="Exemple de vitrine Market Miam : photo de stand, nom du traiteur et sa carte"
          width="900"
          height="1180"
        />
        <figcaption>
          <a href="https://demo.marketmiam.fr" target="_blank" rel="noopener">
            Voir cette vitrine en vrai →
          </a>
        </figcaption>
      </figure>
    </section>
  </main>

  <footer class="foot">
    <p>Market Miam — l’adresse de votre stand.</p>
    <p><a href="/mentions-legales">Mentions légales et confidentialité</a></p>
    <p><a href="/mentions-legales#licence">Logiciel libre</a></p>
    <p><a href="mailto:contact@marketmiam.fr">contact@marketmiam.fr</a></p>
  </footer>

  <script async src="https://tally.so/widgets/embed.js" is:inline></script>
</Base>

<style>
  /* ---- bar ---- */
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: 62rem;
    margin-inline: auto;
    padding: 1.25rem 1.5rem;
  }

  .wordmark {
    display: block;
    line-height: 0;
  }

  /* ---- buttons ---- */
  .btn {
    font: inherit;
    font-weight: 600;
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 0.7rem 1.4rem;
    cursor: pointer;
    transition: background-color 120ms ease, color 120ms ease;
  }

  .btn-solid {
    background: var(--mm-brand);
    color: #fff;
    font-size: 1.05rem;
    padding: 0.9rem 1.9rem;
  }

  .btn-solid:hover {
    background: var(--mm-brand-deep);
  }

  .btn-ghost {
    background: transparent;
    color: var(--mm-ink);
    border-color: var(--mm-line-strong);
    padding: 0.5rem 1.1rem;
    font-size: 0.95rem;
  }

  .btn-ghost:hover {
    background: var(--mm-surface);
  }

  /* ---- type ---- */
  .eyebrow {
    font-family: var(--mm-font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--mm-brand-deep);
    margin-bottom: 0.9rem;
  }

  h1 {
    font-size: clamp(2.1rem, 6vw, 3.6rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.03em;
    max-width: 18ch;
  }

  .lede {
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    color: var(--mm-ink-soft);
    max-width: 52ch;
    margin-top: 1.25rem;
  }

  .soon {
    max-width: 52ch;
    margin-top: 1.25rem;
    padding-left: 1.1rem;
    border-left: 3px solid var(--mm-brand);
    color: var(--mm-ink-soft);
  }

  .soon strong {
    color: var(--mm-ink);
    font-weight: 600;
  }

  /* ---- sections ---- */
  .shot {
    margin-top: 2.5rem;
    max-width: 26rem;
  }

  .shot img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--mm-line-strong);
    border-radius: 16px;
    box-shadow: 0 18px 40px -18px rgb(42 36 30 / 0.35);
  }

  /* The shot is of demo.marketmiam.fr; the caption turns it into the real
     thing. A plain link, not a second button — the page sells the pilot. */
  .shot figcaption {
    margin-top: 0.85rem;
    font-size: 0.9rem;
    text-align: center;
  }

  .shot figcaption a {
    color: var(--mm-brand-deep);
    font-weight: 600;
  }

  @media (min-width: 56rem) {
    .hero {
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      align-items: center;
      gap: 3rem;
    }

    .shot {
      margin-top: 0;
      max-width: none;
    }

    .shot figcaption {
      text-align: left;
    }
  }

  .hero {
    max-width: 62rem;
    margin-inline: auto;
    padding: clamp(3rem, 9vw, 6rem) 1.5rem clamp(3.5rem, 9vw, 6rem);
  }

  /* Centred while the page is a single column, flush left once the hero splits in two. */
  .hero-actions {
    margin-top: 2.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 0.85rem 1.25rem;
  }

  @media (min-width: 56rem) {
    .hero-actions {
      justify-content: flex-start;
      text-align: left;
    }
  }

  /* ---- footer ---- */
  .foot {
    max-width: 62rem;
    margin-inline: auto;
    padding: 2.5rem 1.5rem 3.5rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    font-size: 0.9rem;
    color: var(--mm-muted);
  }

  .foot a {
    color: var(--mm-brand-deep);
  }
</style>
