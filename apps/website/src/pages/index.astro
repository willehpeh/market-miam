---
import Base from '../layouts/Base.astro';

// ponytail: deux valeurs à changer avant mise en ligne.
const TALLY_FORM_ID = 'aQX9NB';
const PRIX_MENSUEL = '15 € HT';

const cta = {
  'data-tally-open': TALLY_FORM_ID,
  'data-tally-layout': 'modal',
  'data-tally-width': '480',
  'data-tally-emoji-text': '👋',
  'data-tally-emoji-animation': 'wave',
};

const groupes = [
  {
    titre: 'Une fois pour toutes',
    lede: 'Vous l’installez une fois, avec nous, pendant la mise en route. Ensuite vous n’y touchez plus.',
    cartes: [
      {
        titre: 'Votre vitrine',
        texte:
          'chez-vous.marketmiam.fr — votre photo, vos couleurs, votre présentation. Une adresse que vous donnez à vos clients et qui ne disparaît pas.',
      },
      {
        titre: 'Votre carte',
        texte:
          'Tous vos plats, décrits une bonne fois pour toutes. Vous les ressortez d’un marché à l’autre au lieu de tout retaper à chaque fois.',
      },
      {
        titre: 'Vos marchés',
        texte:
          'Quels marchés, quels jours, quels horaires. Vos habitués savent quand vous êtes chez eux, et n’ont plus à demander si vous venez aussi le mercredi.',
      },
    ],
  },
  {
    titre: 'À chaque marché',
    lede: 'Le rythme de la semaine, depuis votre téléphone. Quelques touches à chaque fois.',
    cartes: [
      {
        titre: 'Le menu du jour',
        texte:
          'Ce que vous servez à chaque marché, publié la veille ou le matin même. Vos habitués savent ce qui les attend avant de sortir de chez eux.',
      },
      {
        titre: 'Pendant le marché',
        texte:
          'Un plat est parti ? Une touche, et il passe en épuisé sur votre vitrine. Vos clients en route le voient avant d’arriver. Et quand vous remballez — ou si vous ne pouvez pas venir — vous fermez le stand : votre vitrine cesse d’annoncer un marché où vous n’êtes plus.',
      },
      {
        titre: 'Après le marché',
        texte:
          'De retour chez vous, vous dites en une fois comment chaque plat est parti — bien vendu, moins bien vendu, épuisé. Ceux que vous aviez marqués épuisés pendant le marché sont déjà cochés.',
      },
    ],
  },
  {
    titre: 'Au fil des marchés',
    lede: 'Rien de plus à saisir : ce que vous avez déjà répondu revient vous aider à préparer.',
    cartes: [
      {
        titre: 'Ce qui part, et ce qui reste',
        texte:
          'Quand vous préparez le menu d’un marché, chaque plat vous rappelle comment il y est parti les fois précédentes — toujours épuisé, ça part bien, il en reste. Marché par marché : un plat qui s’arrache ici peut rentrer avec vous d’ailleurs.',
      },
    ],
  },
];
---

<Base title="Market Miam — l’adresse de votre stand">
  <header class="bar">
    <a class="wordmark" href="/">
      <img src="/logo.webp" alt="Market Miam" width="160" height="25" />
    </a>
    <button class="btn btn-ghost" {...cta}>Rejoindre le pilote</button>
  </header>

  <main>
    <section class="hero">
      <div>
        <p class="eyebrow">Pour les traiteurs de marché</p>
        <h1>Le lien avec vos habitués ne s’arrête pas quand vous remballez.</h1>
        <p class="lede">
          Market Miam donne à chaque traiteur sa propre vitrine : votre carte, vos marchés,
          et le menu du jour publié marché par marché. Une adresse à donner une fois, que vos
          habitués gardent — et consultent entre deux marchés.
        </p>
        <div class="hero-actions">
          <button class="btn btn-solid" {...cta}>Rejoignez les premiers traiteurs</button>
          <p class="note">Premier mois offert. Sans engagement.</p>
        </div>
      </div>
      <figure class="shot">
        <img
          src="/storefront-demo.webp"
          alt="Exemple de vitrine Market Miam : photo de stand, nom du traiteur et sa carte"
          width="900"
          height="1180"
        />
        <figcaption>
          <a href="https://demo.marketmiam.fr" target="_blank" rel="noopener">
            Voir cette vitrine en vrai →
          </a>
        </figcaption>
      </figure>
    </section>

    <section class="band">
      <div class="wrap">
        <h2>Vous vendez sur les marchés. Tout le reste, vous le bricolez.</h2>
        <ul class="problems">
          <li>
            <strong>Entre deux marchés, vous n’existez plus.</strong>
            Un habitué qui veut savoir ce que vous servez cette semaine, montrer votre stand à
            un ami, ou vérifier que vous serez bien là — n’a rien à consulter et personne à
            qui demander.
          </li>
          <li>
            <strong>Vous racontez vos plats au téléphone, dix fois par jour.</strong>
            Ce qu’il y a dedans, comment c’est préparé, ce qu’il vous reste — les mêmes
            réponses, client après client.
          </li>
          <li>
            <strong>Vous préparez à l’aveugle.</strong>
            Trop, et vous rentrez avec des invendus. Pas assez, et vous refusez des clients.
          </li>
        </ul>
      </div>
    </section>

    {/* Grouped by what each thing costs the vendor — once, every market, or nothing —
        because "combien de temps ça va me prendre ?" is the objection, and a flat list of
        seven cards answers it nowhere. The last group holds one card on purpose: the
        section ends on the thing that gives back rather than burying it seventh. */}
    <section class="wrap section">
      <h2>Ce que Market Miam vous donne</h2>
      {
        groupes.map((groupe, index) => (
          <div class:list={['groupe', index === groupes.length - 1 && 'groupe-final']}>
            <h3>{groupe.titre}</h3>
            <p class="lede lede-tight">{groupe.lede}</p>
            <div class="cards">
              {groupe.cartes.map((carte) => (
                <article class="card">
                  <h4>{carte.titre}</h4>
                  <p>{carte.texte}</p>
                </article>
              ))}
            </div>
          </div>
        ))
      }
    </section>

    <section class="band band-deep">
      <div class="wrap">
        <p class="eyebrow eyebrow-light">La phase pilote</p>
        <h2>Nous accompagnons cinq à dix traiteurs, personnellement.</h2>
        <p class="lede lede-light">
          Vous n’êtes pas un numéro dans une file d’attente : nous mettons votre vitrine en
          place avec vous, et nous construisons la suite à partir de ce que vous nous dites.
        </p>
        <ul class="terms">
          <li>
            <strong>Premier mois offert</strong>, puis <strong>{PRIX_MENSUEL} par mois</strong>
            (18&nbsp;€&nbsp;TTC). Sans engagement — vous arrêtez quand vous voulez.
          </li>
          <li>
            <strong>Le tarif ne bouge pas</strong> — ce qui arrive ensuite est compris, sans
            supplément.
          </li>
          <li><strong>Aucune commission</strong> sur vos ventes. Jamais.</li>
          <li><strong>Vos clients restent vos clients</strong> — pas ceux d’une plateforme.</li>
        </ul>
        <div class="pilot-actions">
          <button class="btn btn-solid" {...cta}>Rejoignez les premiers traiteurs</button>
          <p class="note note-light">Deux minutes, trois questions.</p>
        </div>
      </div>
    </section>
  </main>

  <footer class="foot">
    <p>Market Miam — l’adresse de votre stand.</p>
    <p><a href="/mentions-legales">Mentions légales et confidentialité</a></p>
    <p><a href="/mentions-legales#licence">Logiciel libre</a></p>
    <p><a href="mailto:contact@marketmiam.fr">contact@marketmiam.fr</a></p>
  </footer>

  <script async src="https://tally.so/widgets/embed.js" is:inline></script>
</Base>

<style>
  .wrap {
    max-width: 62rem;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  /* ---- bar ---- */
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: 62rem;
    margin-inline: auto;
    padding: 1.25rem 1.5rem;
  }

  .wordmark {
    display: block;
    line-height: 0;
  }

  /* ---- buttons ---- */
  .btn {
    font: inherit;
    font-weight: 600;
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 0.7rem 1.4rem;
    cursor: pointer;
    transition: background-color 120ms ease, color 120ms ease;
  }

  .btn-solid {
    background: var(--mm-brand);
    color: #fff;
    font-size: 1.05rem;
    padding: 0.9rem 1.9rem;
  }

  .btn-solid:hover {
    background: var(--mm-brand-deep);
  }

  .btn-ghost {
    background: transparent;
    color: var(--mm-ink);
    border-color: var(--mm-line-strong);
    padding: 0.5rem 1.1rem;
    font-size: 0.95rem;
  }

  .btn-ghost:hover {
    background: var(--mm-surface);
  }

  /* ---- type ---- */
  .eyebrow {
    font-family: var(--mm-font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--mm-brand-deep);
    margin-bottom: 0.9rem;
  }

  .eyebrow-light {
    color: var(--mm-brand-soft);
  }

  h1 {
    font-size: clamp(2.1rem, 6vw, 3.6rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.03em;
    max-width: 18ch;
  }

  h2 {
    font-size: clamp(1.5rem, 3.4vw, 2.1rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    max-width: 26ch;
  }

  /* Brand-deep and over a rule, because size alone did not separate a group heading from
     a card title — both are bold and dark, and the three groups read as one long list.
     The colour is the same structural-label language as .eyebrow. */
  h3 {
    font-size: clamp(1.15rem, 2.2vw, 1.4rem);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--mm-brand-deep);
  }

  h4 {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .lede {
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    color: var(--mm-ink-soft);
    max-width: 52ch;
    margin-top: 1.25rem;
  }

  .lede-tight {
    margin-top: 0.9rem;
    font-size: 1.05rem;
  }

  .lede-light {
    color: var(--mm-brand-soft);
  }

  .note {
    font-size: 0.9rem;
    color: var(--mm-muted);
  }

  .note-light {
    color: var(--mm-sidebar-ink);
    margin-top: 0.9rem;
  }

  /* ---- sections ---- */
  .shot {
    margin-top: 2.5rem;
    max-width: 26rem;
  }

  .shot img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--mm-line-strong);
    border-radius: 16px;
    box-shadow: 0 18px 40px -18px rgb(42 36 30 / 0.35);
  }

  /* The shot is of demo.marketmiam.fr; the caption turns it into the real
     thing. A plain link, not a second button — the page sells the pilot. */
  .shot figcaption {
    margin-top: 0.85rem;
    font-size: 0.9rem;
    text-align: center;
  }

  .shot figcaption a {
    color: var(--mm-brand-deep);
    font-weight: 600;
  }

  @media (min-width: 56rem) {
    .hero {
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      align-items: center;
      gap: 3rem;
    }

    .shot {
      margin-top: 0;
      max-width: none;
    }

    .shot figcaption {
      text-align: left;
    }
  }

  .hero {
    max-width: 62rem;
    margin-inline: auto;
    padding: clamp(3rem, 9vw, 6rem) 1.5rem clamp(3.5rem, 9vw, 6rem);
  }

  /* Each CTA and the reassurance line under it read as one unit. Centred while
     the page is a single column, flush left once the hero splits in two. */
  .hero-actions {
    margin-top: 2.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 0.85rem 1.25rem;
  }

  .pilot-actions {
    text-align: center;
  }

  @media (min-width: 56rem) {
    .hero-actions {
      justify-content: flex-start;
      text-align: left;
    }

    .pilot-actions {
      text-align: left;
    }
  }

  .section {
    padding-block: clamp(3rem, 8vw, 5rem);
  }

  .band {
    background: var(--mm-surface);
    border-block: 1px solid var(--mm-line);
    padding-block: clamp(3rem, 8vw, 5rem);
  }

  .band-deep {
    background: var(--mm-sidebar);
    color: var(--mm-brand-soft);
    border-block: none;
  }

  .band-deep h2 {
    color: #fff;
  }

  /* ---- lists ---- */
  .problems {
    list-style: none;
    margin-top: 2rem;
    display: grid;
    gap: 1.1rem;
    max-width: 58ch;
  }

  .problems li {
    color: var(--mm-ink-soft);
    padding-left: 1.1rem;
    border-left: 3px solid var(--mm-brand-soft);
  }

  .problems strong {
    display: block;
    color: var(--mm-ink);
    font-weight: 600;
  }

  .groupe {
    margin-top: clamp(2.25rem, 5vw, 3.25rem);
    padding-top: clamp(1.5rem, 3vw, 2rem);
    border-top: 1px solid var(--mm-line-strong);
  }

  /* The last group holds one card, which the auto-fit grid stretches the full width. Left
     plain it reads as a tile someone forgot to pair; tinted, it reads as the payoff the
     section is built towards, which is what it is. */
  .groupe-final .card {
    background: var(--mm-brand-soft);
    border-color: transparent;
  }

  /* Inside a group the cards follow their own lede, not a section heading, so they sit
     closer than the ungrouped 2.25rem would put them. */
  .groupe .cards {
    margin-top: 1.25rem;
  }

  .cards {
    margin-top: 2.25rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1.25rem;
  }

  .card {
    background: var(--mm-surface);
    border: 1px solid var(--mm-line);
    border-radius: 14px;
    padding: 1.5rem;
  }

  .card p {
    color: var(--mm-ink-soft);
    font-size: 0.98rem;
  }

  .terms {
    list-style: none;
    margin: 2rem 0;
    display: grid;
    gap: 0.8rem;
    max-width: 52ch;
    color: var(--mm-sidebar-ink);
  }

  .terms strong {
    color: #fff;
    font-weight: 600;
  }

  /* ---- footer ---- */
  .foot {
    max-width: 62rem;
    margin-inline: auto;
    padding: 2.5rem 1.5rem 3.5rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    font-size: 0.9rem;
    color: var(--mm-muted);
  }

  .foot a {
    color: var(--mm-brand-deep);
  }
</style>
