---
// Renders a snippet and prints the same snippet under it, so what is shown and what is
// copied can never disagree.
interface Props {
  title: string;
  note?: string;
  code: string;
}

const { title, note, code } = Astro.props;
---

<article class="overflow-hidden rounded-card border border-line bg-surface">
  <header class="space-y-1 px-5 pt-4">
    <h3 class="font-mono text-sm">{title}</h3>
    {note && <p class="text-sm text-muted">{note}</p>}
  </header>
  <div class="flex flex-wrap items-center gap-3 p-5"><Fragment set:html={code} /></div>
  <pre class="overflow-x-auto border-t border-line bg-surface-sunk px-5 py-3 font-mono text-xs text-ink-soft"><code>{code}</code></pre>
</article>
