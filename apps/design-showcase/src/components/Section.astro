---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section id={id} class="scroll-mt-8 space-y-6">
  <header class="space-y-2">
    <h2 class="text-2xl">{title}</h2>
    <div class="max-w-2xl text-ink-soft"><slot name="intro" /></div>
  </header>
  <slot />
</section>
